<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:vendor|rate-limit-storage|logs?)(?:/|$) - [F,L,NC]
  RewriteRule ^templates(?:/|$) - [F,L,NC]
  RewriteRule ^(?:smtp_config(?:\.(?:local|example))?\.php|password_reset_relay(?:\.(?:local|example))?\.php|\.env(?:\..*)?)$ - [F,L,NC]
  RewriteRule \.(?:log|sql|zip|bak|backup|old|orig|swp|pem|key|map|lock)$ - [F,L,NC]
</IfModule>

<IfModule mod_authz_core.c>
  <FilesMatch "^(?:db\.php|composer\.(?:json|lock)|smtp_config(?:\.(?:local|example))?\.php|password_reset_relay(?:\.(?:local|example))?\.php|\.env(?:\..*)?)$">
    Require all denied
  </FilesMatch>
</IfModule>
